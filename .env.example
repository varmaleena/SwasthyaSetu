APP_ENV=local
# Local SQLite is a development fallback ONLY. Hosted demo requires distinct PostgreSQL URLs.
STATE_A_DATABASE_URL=sqlite:///state_a.db
STATE_B_DATABASE_URL=sqlite:///state_b.db
DEMO_TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL_ID=
# Must be explicitly verified by the account owner before enabling AI.
GEMINI_FREE_TIER_VERIFIED=false
AI_GLOBAL_DAILY_LIMIT=0
STATE_A_STORAGE_URL=
STATE_A_STORAGE_KEY=
STATE_B_STORAGE_URL=
STATE_B_STORAGE_KEY=
BUILD_SHA=local
